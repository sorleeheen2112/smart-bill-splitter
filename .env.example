# Supabase Project Credentials (ฟรี 100%)
# รับได้จากหน้าเว็บ Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Google Gemini API Key (สำหรับสแกนบิลด้วย AI)
# รับฟรีได้จาก Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
