# Supabase Project Credentials (ฟรี 100%)
# รับได้จากหน้าเว็บ Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Google Gemini API Key (สำหรับสแกนบิลด้วย AI)
# รับฟรีได้จาก Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Developer Support / Donation Configuration (ตัวเลือกเสริมสำหรับปุ่มสนับสนุนผู้พัฒนา)
NEXT_PUBLIC_ENABLE_DONATION=false
NEXT_PUBLIC_DONATION_PROMPTPAY_NUMBER=0812345678
NEXT_PUBLIC_DONATION_PROMPTPAY_NAME=ชื่อ-นามสกุล ผู้รับเงินสนับสนุน

# SlipOK API Configuration (สำหรับตรวจสลิปโอนเงินอัตโนมัติ)
# สมัครรับ API Key ฟรีได้ที่ https://slipok.com
SLIPOK_API_KEY=your_slipok_api_key_here
SLIPOK_BRANCH_ID=your_branch_id_here
# Optional: กำหนด endpoint เอง (ถ้าไม่ใส่จะใช้ https://api.slipok.com/api/line/apikey/${SLIPOK_BRANCH_ID} อัตโนมัติ)
SLIPOK_ENDPOINT=https://api.slipok.com/api/line/apikey/your_branch_id_here
